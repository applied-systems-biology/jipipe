  "metadata" : {
    "name" : "Kidney analysis",
    "description" : "<html>\n  <head>\n    \n  </head>\n  <body>\n    <p>\n      <b><font size=\"6\">Kidney analysis pipeline </font></b>\n    </p>\n    <p>\n      \n    </p>\n    <p>\n      This is a simple kidney analysis pipeline that finds the tissue area and \n      glomeruli statistics.\n    </p>\n  </body>\n</html>\n",
    "summary" : "<html>\n  <head>\n    \n  </head>\n  <body>\n    <p>\n      Analyzes kidneys\n    </p>\n  </body>\n</html>\n",
